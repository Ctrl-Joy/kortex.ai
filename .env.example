# KORTEX AI — environment configuration (copy to .env and edit).
# Placeholders only. Never commit a real .env file.

# ---- API service --------------------------------------------------------
# SQLite file used by the local prototype (relative to repo root).
KORTEX_DATABASE_URL=sqlite:///./data/kortex.db

# Secret used to sign staff session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KORTEX_SECRET_KEY=change-me-to-a-long-random-string

# Shared key the vision service sends in the X-Vision-Key header.
KORTEX_VISION_API_KEY=change-me-vision-key

# Password assigned to the seeded demo staff accounts on first seed only.
# (usernames: "manager" and "attendant")
KORTEX_SEED_STAFF_PASSWORD=change-me-staff-password

# Comma-separated list of browser origins allowed to call the API.
KORTEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins (e.g. Vercel previews). Leave empty locally.
KORTEX_CORS_ORIGIN_REGEX=

# Staff token lifetime in minutes.
KORTEX_TOKEN_TTL_MINUTES=720

# ---- Vision service -----------------------------------------------------
KORTEX_API_URL=http://127.0.0.1:8000
VISION_CAMERA_INDEX=0
# Optional RTSP/HTTP stream instead of a local webcam (keep credentials out of git):
VISION_CAMERA_URL=
VISION_FRAME_WIDTH=640
VISION_FRAME_HEIGHT=480
VISION_PROCESS_FPS=6
VISION_MODEL=yolo11n.pt
VISION_ZONE_ID=SHELF-A1
VISION_PORT=8100

# ---- Web app (Vite exposes only VITE_* variables to the browser) ----------
# Leave empty to use the Vite dev proxy (recommended, also works from a phone).
VITE_API_BASE_URL=
VITE_VISION_BASE_URL=
